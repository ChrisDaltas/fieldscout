# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Required by scripts/ (e.g. npm run seed:dev) and any
# server-only code that needs cross-user reads. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI (server-only — never expose to the browser)
# Claude API key. Required by /api/lists/generate, persona generation scripts,
# and (later) /api/ask. AI features degrade with a clear error when unset.
ANTHROPIC_API_KEY=
# Vercel Cron auth: Vercel sends "Authorization: Bearer $CRON_SECRET" to
# /api/cron/* when this is set. Required in production for daily ingestion.
CRON_SECRET=
# Ask AI — Vegas lines (free tier). Not used until M6.
THE_ODDS_API_KEY=
# NFL current/live stats provider (anticipated by the architecture doc).
SPORTS_DATA_API_KEY=

# Current NFL week now comes live from Sleeper (/v1/state/nfl, cached 1h) via
# lib/sports-data/nfl-state.ts. NEXT_PUBLIC_NFL_WEEK is only the fallback when
# Sleeper is unreachable; set the OVERRIDE to force a week for local testing
# of in-season states (1-18, or 0 for offseason).
NEXT_PUBLIC_NFL_WEEK=0
NEXT_PUBLIC_NFL_WEEK_OVERRIDE=

# Feature release gates (src/lib/feature-flags.ts)
# Unset: ON in local dev, OFF in deployed builds. Set "true" to release a
# feature in production, or "false" to preview the released app locally.
# Leagues, league teams, and the live draft (mock UI, no backend yet):
NEXT_PUBLIC_FLAG_LEAGUES=
# Direct messages rail panel (mock UI, no backend yet):
NEXT_PUBLIC_FLAG_MESSAGES=

# Dev auth bypass (local only)
# When "true", the app auto-signs-in the seeded dev user on first load so you
# can skip the login UI. Auth itself is still real — RLS, is_pro, and all
# business rules behave exactly like production. A build-time assert refuses
# to compile a production bundle while this is "true".
# Seed the dev users with: npm run seed:dev
NEXT_PUBLIC_DEV_AUTH=false
# Which seeded user to auto-sign-in as. Switch to dev-pro@fieldscout.local to
# exercise the Pro user (is_pro=true). Defaults to dev@fieldscout.local.
NEXT_PUBLIC_DEV_AUTH_EMAIL=dev@fieldscout.local
